# ---- Cloud Modernization Agent: example environment ----
# Copy to .env and adjust. Defaults work with zero external services.

# Application
APP_NAME="Cloud Modernization Agent"
LOG_LEVEL=INFO

# Database (SQLite by default; PostgreSQL works via e.g. postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./data/cloud_modernization.db

# LLM provider. "mock" = deterministic facts-only narrator (no network calls).
# "openai-compatible" = any OpenAI-compatible /chat/completions endpoint (vLLM, Ollama, LM Studio, Azure-compatible gateways...).
LLM_MODE=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=mock-model

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:8015,http://127.0.0.1:8015

# Estate simulator size (number of applications generated; planted showcase apps are always included)
ESTATE_SIZE=120

# Default provider profile for target-architecture rendering: aws | azure | gcp
DEFAULT_PROVIDER_PROFILE=aws
